{
	"name": "lint-kit",
	"version": "0.3.0",
	"description": "An installer for the deterministic tools a repository uses: ESLint rules for Svelte 5 / SvelteKit, i18n, Tailwind and error handling, FastAPI rules for flake8, type checkers, and pre-push checks that a branch leaves the code no worse than its base.",
	"license": "MIT",
	"type": "module",
	"repository": "github:shayshahal/lint-kit",
	"bin": {
		"lint-kit": "bin/lint-kit.js"
	},
	"files": [
		"bin",
		"tools",
		"README.md"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "node --test \"test/*.test.js\""
	},
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.81.0",
		"@typescript-eslint/parser": "^8.71.0",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"jscpd": "^5.4.0",
		"oxlint": "1.81.0",
		"svelte": "^5.57.1",
		"svelte-eslint-parser": "^1.8.1",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@11.3.0"
}
